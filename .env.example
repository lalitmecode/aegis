# Copy to .env and fill in. .env is gitignored.
# Paper trading keys: https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# "true" uses paper-api.alpaca.markets. Set to "false" only with intent.
ALPACA_PAPER_TRADE=true

# LLM provider. Set at most one; ANTHROPIC_API_KEY wins if both are present.
# With neither set the agents run without a model: proposals carry no thesis
# and the critic fails closed. The trade itself is unaffected either way.
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GEMINI_API_KEY=your_gemini_key_here

# Override the model id when a provider deprecates the default. Defaults are
# gemini-3.6-flash and claude-sonnet-4-6.
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=claude-sonnet-4-6
